{
  "manifest_version": 3,
  "name": "chimpread Connector",
  "version": "0.3.0",
  "description": "Save papers to chimpread and cite your library in Google Docs.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "downloads",
    "identity",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://docs.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "chimpread"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html"
}